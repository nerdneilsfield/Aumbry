# Copy to .env and replace every required value before starting the server.
#
# Quote values that contain "$" with single quotes: the bcrypt hash below would otherwise be
# mangled by `make run` (shell) and by docker compose, both of which expand $VARIABLES.

AUMBRY_LISTEN_ADDR=:8080
# Directory for the SQLite database (aumbry.db). /data inside the container.
AUMBRY_DATA_DIR=./data

# Object storage backend: local (default), webdav, s3, or r2.
AUMBRY_STORAGE=local
# Optional object directory for storage=local (defaults to <AUMBRY_DATA_DIR>/objects).
# AUMBRY_LOCAL_PATH=

AUMBRY_ADMIN_USER=admin
# bcrypt hash of the admin password:
#   htpasswd -nbBC 10 '' 'your-password' | cut -d: -f2
# Keep the single quotes. The server refuses to start if this is not a valid bcrypt hash.
AUMBRY_ADMIN_PASSWORD_HASH=

# Comma separated API tokens accepted by POST /api/v1/ingest (Authorization: Bearer <token>).
AUMBRY_API_TOKENS=
# At least 32 random bytes, e.g. `openssl rand -hex 32`. Changing it signs every visitor and admin out.
AUMBRY_COOKIE_SECRET=

# Optional comma-separated list of trusted reverse proxy IPs or CIDRs (default empty).
# AUMBRY_TRUSTED_PROXIES=

# Optional canonical base URL (http(s)://host[:port], no path/query/userinfo) for RSS & Podcast feeds.
# AUMBRY_PUBLIC_URL=https://aumbry.example.com

# Published revisions kept per item (default 20; 0 = unlimited).
# AUMBRY_REVISIONS_MAX_PER_ITEM=20

# Maximum POST /api/v1/ingest body size in MiB (default 200, minimum 20).
# AUMBRY_INGEST_MAX_BODY_MB=200
# Fetch and localize remote <figure src="http(s)://..."> images in v1.2 documents (default true).
# AUMBRY_INGEST_ALLOW_REMOTE_IMAGES=true

# Alternative WebDAV backend (requires AUMBRY_STORAGE=webdav):
# AUMBRY_WEBDAV_URL=https://dav.example.com/aumbry
# AUMBRY_WEBDAV_USER=aumbry
# AUMBRY_WEBDAV_PASS=replace-with-webdav-password

# Alternative S3-compatible backend (requires AUMBRY_STORAGE=s3):
# AUMBRY_S3_ENDPOINT=http://minio:9000
# AUMBRY_S3_REGION=us-east-1
# AUMBRY_S3_BUCKET=aumbry
# AUMBRY_S3_PATH_STYLE=true
# AUMBRY_S3_ACCESS_KEY_ID=
# AUMBRY_S3_SECRET_ACCESS_KEY=

# Alternative Cloudflare R2 backend (requires AUMBRY_STORAGE=r2; checked against docs, not tested on live R2):
# AUMBRY_R2_ACCOUNT_ID=
# AUMBRY_R2_BUCKET=aumbry
# AUMBRY_R2_ACCESS_KEY_ID=
# AUMBRY_R2_SECRET_ACCESS_KEY=
