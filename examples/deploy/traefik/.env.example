# Copy to .env and replace every placeholder before starting. Never commit the real .env.
#
# Quote values that contain "$" with single quotes: docker compose would otherwise expand
# "$2y" in the bcrypt hash as a variable.

# Public host name served by Traefik, and the e-mail registered with Let's Encrypt.
PUBLIC_HOST=aumbry.example.com
ACME_EMAIL=admin@example.com

# Optional. Subnet of the proxy network; it is also written to AUMBRY_TRUSTED_PROXIES.
# PROXY_SUBNET=172.31.250.0/24

AUMBRY_ADMIN_USER=admin
# bcrypt hash of the admin password:
#   htpasswd -nbBC 10 '' 'your-password' | cut -d: -f2
# Keep the single quotes.
AUMBRY_ADMIN_PASSWORD_HASH='$2y$10$replace-with-your-bcrypt-hash'

# Comma separated API tokens for POST /api/v1/ingest.
AUMBRY_API_TOKENS=replace-with-random-token
# At least 32 random bytes: openssl rand -hex 32
AUMBRY_COOKIE_SECRET=replace-with-at-least-32-random-bytes

# Private WebDAV that holds the XML and image objects.
AUMBRY_WEBDAV_URL=https://dav.example.com/aumbry
AUMBRY_WEBDAV_USER=aumbry
AUMBRY_WEBDAV_PASS=replace-with-webdav-password
